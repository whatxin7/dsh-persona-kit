    "src",
    "roles",
    "studio",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node bin/persona.mjs check roles/example-companion.md"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Derpyu520/dsh-persona-kit.git"
  },
  "homepage": "https://github.com/Derpyu520/dsh-persona-kit#readme",
  "bugs": {
    "url": "https://github.com/Derpyu520/dsh-persona-kit/issues"
  }
