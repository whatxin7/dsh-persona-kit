{
  "name": "dsh-persona-kit",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "人格卡工具链：按仿真模式选择小节、结构体检、受控追加「长出来的语气」、预设提示词校验与安全改写。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "persona",
    "role-card",
    "prompt",
    "qq",
    "chatbot"
